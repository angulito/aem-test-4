  "narrative": {
    "northStar": "The Zine Poster",
    "overview": "A black-and-white street-fashion zine at poster scale: wide all-caps Syncopate headlines carry the hierarchy, Instrument Sans stays quiet underneath, and the only colour is a lime highlight on tag pills and the subscribe band. Photography is untreated and rounded at 20px in 2–4 column collages; sections alternate white, #f5f5f5 tint and black at 128px padding. Depth is flat except the signature hard 4px black offset shadow under every pill button.",
    "keyCharacteristics": [
      "uppercase geometric headlines",
      "monochrome with a single lime accent",
      "hard-offset shadow pills",
      "rounded 20px photo tiles",
      "alternating white/tint/black bands",
      "flat cards"
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Lime is the only chroma; at most one band and the tag pills per page.",
        "section": "colors"
      },
      {
        "name": "The Caps-Only Rule",
        "body": "Every heading is uppercase Syncopate 700.",
        "section": "typography"
      },
      {
        "name": "The Hard-Shadow Rule",
        "body": "Shadows are solid black offsets and only buttons have them.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do set every heading in Syncopate 700 uppercase, −0.02em",
      "Do give every pill the 4px 4px 0 #000 shadow, 6px on hover",
      "Do clip photos to 20px, untreated",
      "Do alternate white/#f5f5f5 bands at 128px and end on black",
      "Do reserve lime for tags and the subscribe band"
    ],
    "donts": [
      "Don't use blurred shadows or card gradients",
      "Don't add lavender/lilac or a second accent",
      "Don't set headings mixed-case or in Instrument Sans",
      "Don't change button colour on hover"
    ]
  }
